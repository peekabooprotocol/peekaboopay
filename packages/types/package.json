{
  "name": "@peekaboopay/types",
  "version": "0.2.0",
  "publishConfig": { "access": "public" },
  "description": "Shared type definitions for the Private Agent Shell",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "dev": "tsup --watch"
  },
  "devDependencies": {
    "@peekaboopay/tsconfig": "*"
  }
}
